# Copy to .env (never commit real keys). Venue: paste values from Discord/staff — see VAST_WIRING.md

# --- Store backend -----------------------------------------------------------
STORE_BACKEND=local

VAST_ENDPOINT=
VAST_ACCESS_KEY=
VAST_SECRET_KEY=
VAST_BUCKET=video-agents
VAST_SCHEMA=hack
VAST_S3_ENDPOINT=
VAST_SSL_VERIFY=1
VAST_DRY_RUN=0

DE_BROKER_NAME=dataengine-broker
DE_BROKER_TYPE=Internal
DE_TOPIC=video-agents-uploads
DE_TRIGGER_NAME=sm-standing-upload
DE_FUNCTION_NAME=sm-standing-on-upload
DE_PIPELINE_NAME=sm-standing-pipeline
DE_UPLOAD_PREFIX=uploads/
DE_UPLOAD_SUFFIX=.mp4
